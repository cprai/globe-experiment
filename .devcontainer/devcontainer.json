{
    "name": "rust-claude-code",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "REMOTE_USER": "vscode",
        }
    },
    "mounts": [
        "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
    ],
    "remoteUser": "vscode"
}
